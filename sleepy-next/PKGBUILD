  "patches/2400-2499/2419-sched-bore-7.0.0-burst-oriented-response-enhancer.patch"
  "patches/2400-2499/2420-sched-fair-do-not-scan-twice-in-detach_tasks.patch"
  "patches/2500-2599/2506-x86-boot-validate-SRAT-subtables-before-parsing.patch"
  "patches/9000-9099/9034-drm-amdgpu-fix-VM-update-overrun-on-non-4K-page-kernels.patch"
  "patches/9000-9099/9035-drm-amdgpu-add-the-BO-va-mapping-offset-when-kmapping-an-IB.patch"
  "patches/9000-9099/9039-drm-amdgpu-userq-bound-the-eviction-fence-rearm-retry-loop.patch"
  "patches/9000-9099/9044-drm-amdgpu-userq-skip-unmapped-queues-in-wait_for_signal.patch"
  "patches/9000-9099/9046-amdkfd-fix-integer-overflow-in-queue-ring-buffer-size.patch"
  "patches/9000-9099/9055-drm-amdgpu-userq-fix-userq_signal_ioctl-stuck-in-drm_exec.patch"
  "patches/9000-9099/9056-drm-amdgpu-userq-filter-out-idle-userqs-from-pending-signal-list.patch"
  "patches/9000-9099/9057-drm-amdgpu-keep-freed-VM-mappings-on-clear-failure.patch"
  "patches/9000-9099/9062-drm-amdgpu-introduce-amdgpu_lookup_queue_by_doorbell.patch"
  "patches/9000-9099/9063-drm-amdgpu-keep-the-userq-manager-alive-as-long-as-its-queues.patch"
  "patches/9000-9099/9065-drm-amdgpu-gfx12-hold-userq-refs-in-private-fault-worker.patch"
  "patches/9000-9099/9066-drm-amdgpu-implement-asynchronous-userq-destruction-routine.patch"
  "patches/9000-9099/9067-drm-amdgpu-hold-userq-kref-in-MES-reset.patch"
  "patches/9000-9099/9068-drm-amdgpu-hold-userq-kref-during-isolation-scheduling.patch"
  "patches/9000-9099/9069-drm-amdgpu-hold-userq-kref-during-suspend-and-resume.patch"
  "patches/9000-9099/9070-drm-amdgpu-free-userq-by-kref_put-when-fails-to-create.patch"
  "patches/9000-9099/9071-drm-amdgpu-take-queue-kref-in-userq_create-to-avoid-UAF.patch"
  "patches/9000-9099/9081-drm-amdgpu-userq-commit-seq64-BO-mapping.patch"
  "patches/9000-9099/9083-drm-amdkfd-disable-SVM-when-the-GPUVM-cannot-cover-CPU-addresses.patch"
  "patches/9000-9099/9084-drm-amdkfd-validate-SVM-ranges-against-GPU-address-limits.patch"
  "patches/9000-9099/9086-drm-amdkfd-validate-SRAT-subtables-before-parsing.patch"
  "patches/9000-9099/9089-drm-amdkfd-split-vram_pages-of-SVM-ranges-prefetched.patch"
  # 1008/1012/1013/1014/1017 (amdgpu TLB-invalidation rework) are excluded from the
  # preview package only: 1008 no longer applies to this snapshot while 1012/1013 do,
  # and 1012/1013 consume the tlb_inv_num_dw member and amdgpu_emit_tlb_inv() helper
  # that only 1008 declares. Partial application does not compile. sleepy-rc retains
  # all five.
  # Absorbed by next-20261021 and dropped on the 2026-10-21 bump:
  # 1063, 1082, 1083, 1085, 1091, 1092, 1176, 1181, 1182, 1233, 2046, 2058, 2803.
  # 0101 and 2419 were rebased for this snapshot; 1175 lost its
  # hdmi_automation_enable hunk, whose handler the base replaced with
  # debugfs_create_bool.
  # 1174 (scanout alpha) was preview-only and its change is in the base.
  # Removed 2026-10-17; sleepy-rc never carried this one.

  # New range 27xx: mm/swap (zswap, xswap). The 21xx MM range is full apart from
  # 2199, and every other gap in it is a VACATED number (the dropped MGLRU batch,
  # absorbed carries) which must not be reused, so this series opens a new range
  # rather than splitting across one.
  # 9040 excluded from the preview: superseded here by the base's own
  # amdgpu_cs_ioctl() error_free_user_pages label. Applying it adds a second
  # free loop in amdgpu_cs_parser_fini(); the range is NULL by then, so it is
  # harmless but redundant. sleepy-rc still needs it.
  # 9060 excluded from the preview: absorbed upstream in this snapshot. Its
  # svm_range_window_resident() is already in kfd_migrate.c, so applying it inserts a
  # second definition and the build dies on a redefinition. sleepy-rc retains it.
  # 9078/9079 were preview-only and are in the base. Removed 2026-10-17.
)

# makepkg 7.1.0 resolves local sources by basename in the PKGBUILD directory
# (get_filename strips directory prefixes). The patches live in patches/<range>/
# subfolders for a clean repo view, so create root-level symlinks here — this
# body code runs when makepkg sources the PKGBUILD, before source resolution.
# The symlinks are gitignored (see .gitignore) so the repo root stays clean.
# Drop links left behind by a patch that was renamed, replaced or dropped.
# `[[ -e ]]` follows symlinks, so a dangling link fails the test and the
# `ln -s` below then fails with "File exists" because the name is taken — the
# stale link survives and makepkg later resolves the wrong file. Prune first.
for _sleepy_stale in *.patch; do
  [[ -L "$_sleepy_stale" && ! -e "$_sleepy_stale" ]] && rm -f "$_sleepy_stale"
done
for _sleepy_patch in "${source[@]}"; do
  case "$_sleepy_patch" in
    patches/*.patch)
      _sleepy_base="${_sleepy_patch##*/}"
      [[ -e "$_sleepy_base" ]] || ln -sf "$_sleepy_patch" "$_sleepy_base"
      ;;
  esac
done
unset _sleepy_patch _sleepy_base _sleepy_stale

validpgpkeys=(
  E18447AC260021D31F3FF6C4C8A2A4774B8B63C4  # Eric Naim <dnaim@cachyos.org>
  E8B9AA39F054E30E8290D492C3C4820857F654FE  # Peter Jung <admin@ptr1337.dev>
)
# Pre-built LLVM toolchain: the official GitHub llvm-project release asset
# LLVM-23.1.0-Linux-X64.tar.xz (llvmorg-23.1.0, added to source() below) is the
# toolchain actually used. It links against ICU 70 (Arch ships ICU 78), so the
# libs are bundled via the llvm-icu70-libs source. The kernel.org
# ClangBuiltLinux weekly-rc auto-fetch was dropped 2026-09-02 (legacy
# _kernel_org_llvm_tarball was never added to source()).
: "${_use_kernel_org_llvm:=yes}"
: "${_llvm_dir_name:=LLVM-23.1.0-Linux-X64}"

_set_build_flags() {
    if _is_lto_kernel; then
        if [ "$_use_kernel_org_llvm" = "yes" ]; then
            export PATH="${srcdir}/${_llvm_dir_name}/bin:${PATH}"
            # GitHub LLVM 23.1.0 needs ICU 70 (see llvm-icu70-libs source)
            mkdir -p "${srcdir}/${_llvm_dir_name}/lib"
            tar xzf "$srcdir/llvm-icu70-libs.tar.gz" -C "${srcdir}/${_llvm_dir_name}/lib"
            export LD_LIBRARY_PATH="${srcdir}/${_llvm_dir_name}/lib:${LD_LIBRARY_PATH}"
            BUILD_FLAGS=(
                CC=clang
                LD=ld.lld
                LLVM=1
                LLVM_IAS=1
                PAHOLE=/usr/bin/pahole
            )
        else
            makedepends+=(clang llvm lld)
            BUILD_FLAGS=(
                CC=clang
                LD=ld.lld
                LLVM=1
                LLVM_IAS=1
                PAHOLE=/usr/bin/pahole
            )
        fi
    fi
}

