+def extract_function(text, name):
+    match = re.search(r'^(?:static )?(?:unsigned long|int|void|bool|u64)\s+' + re.escape(name)
+                      + r'\(.*?^\}', text, re.M | re.S)
+    if not match:
+        raise AssertionError('Production function not found: ' + name)
+    return match.group()
