+#define kvfree kfree
+static void *memdup_array_user(const void *ptr, size_t count, size_t size)
+{
+    if (count && (!ptr || ptr == bad_pointer))
+        return ERR_PTR(-EFAULT);
+    void *copy = allocate(count * size);
+    if (!copy)
+        return ERR_PTR(-ENOMEM);
