+        (failure == WRITE_LOOKUP && lookup_count == 2))
+        return -EFAULT;
+    *out = allocate(count * sizeof(**out));
+    if (!*out)
+        return -ENOMEM;
+    for (unsigned i = 0; i < count; ++i) {
