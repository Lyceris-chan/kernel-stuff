+def source(file):
+    revision = os.environ.get('USERQ_TEST_REVISION')
+    if revision:
+        return subprocess.check_output(['git', 'show', revision + ':' + AMD + file],
+                                       cwd=ROOT, text=True)
+    return (ROOT / AMD / file).read_text()
