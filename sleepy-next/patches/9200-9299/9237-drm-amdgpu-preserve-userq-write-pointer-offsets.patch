From d56b9554c43c118e725ac4e5cf9adcd46b89b303 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Wed, 4 Nov 2026 02:13:37 +0100
Subject: [PATCH] drm/amdgpu: Preserve UserQ write-pointer offsets.

(cherry picked from commit f0de1dafec7b891205ca290fd06a9b041900985e)
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c     |  3 +-
 drivers/gpu/drm/amd/amdgpu/amdgpu_userq.h     |  2 +
 drivers/gpu/drm/amd/amdgpu/mes_userqueue.c    | 13 +++-
 .../drivers/amdgpu/test_userq_restore.py      | 36 ++++++++++-
 .../drivers/amdgpu/test_userq_upstream.py     | 61 ++++++++++++++++---
 5 files changed, 102 insertions(+), 13 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
index fbbf4ca482e0..505eb610bcf1 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
@@ -1574,7 +1574,8 @@ amdgpu_userq_vm_validate_and_restore_queue(struct amdgpu_userq_mgr *uq_mgr)
 			goto unlock_all;
 		}
 
-		queue->wptr_obj.gpu_addr = amdgpu_bo_gpu_offset(bo);
+		queue->wptr_obj.gpu_addr = amdgpu_bo_gpu_offset(bo) +
+					    queue->wptr_bo_offset;
 	}
 
 	ret = amdgpu_evf_mgr_rearm(&fpriv->evf_mgr, &exec);
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.h
index 5975dc4e5171..c17615ff78a9 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.h
@@ -65,6 +65,8 @@ struct amdgpu_usermode_queue {
 	struct amdgpu_userq_obj	db_obj;
 	struct amdgpu_userq_obj fw_obj;
 	struct amdgpu_userq_obj wptr_obj;
+	/* Byte offset within wptr_obj.obj, retained when the BO moves. */
+	u64			wptr_bo_offset;
 
 	/**
 	 * @fence_drv_lock: Protecting @fence_drv_xa.
diff --git a/drivers/gpu/drm/amd/amdgpu/mes_userqueue.c b/drivers/gpu/drm/amd/amdgpu/mes_userqueue.c
index 929cf9f0bb4c..7d410c144f87 100644
--- a/drivers/gpu/drm/amd/amdgpu/mes_userqueue.c
+++ b/drivers/gpu/drm/amd/amdgpu/mes_userqueue.c
@@ -21,6 +21,7 @@
  * OTHER DEALINGS IN THE SOFTWARE.
  *
  */
+#include <linux/overflow.h>
 #include <drm/drm_drv.h>
 #include "amdgpu.h"
 #include "amdgpu_gfx.h"
@@ -42,6 +43,7 @@ mes_userq_create_wptr_mapping(struct amdgpu_device *adev,
 	struct amdgpu_bo *obj;
 	struct amdgpu_vm *vm = queue->vm;
 	struct drm_exec exec;
+	u64 offset;
 	int ret;
 
 	wptr &= AMDGPU_GMC_HOLE_MASK;
@@ -73,7 +75,13 @@ mes_userq_create_wptr_mapping(struct amdgpu_device *adev,
 	}
 
 	wptr_obj->obj = amdgpu_bo_ref(wptr_mapping->bo_va->base.bo);
-	if (wptr_obj->obj->tbo.base.size > PAGE_SIZE) {
+	offset = wptr - (wptr_mapping->start << AMDGPU_GPU_PAGE_SHIFT);
+	/* The full WPTR must fit both its VA mapping and its backing BO. */
+	if (wptr_obj->obj->tbo.base.size > PAGE_SIZE ||
+	    ((wptr + sizeof(u64) - 1) >> AMDGPU_GPU_PAGE_SHIFT) > wptr_mapping->last ||
+	    check_add_overflow(offset, wptr_mapping->offset, &offset) ||
+	    offset > wptr_obj->obj->tbo.base.size ||
+	    wptr_obj->obj->tbo.base.size - offset < sizeof(u64)) {
 		ret = -EINVAL;
 		goto fail_map;
 	}
@@ -90,7 +98,8 @@ mes_userq_create_wptr_mapping(struct amdgpu_device *adev,
 		goto fail_map;
 	}
 
-	queue->wptr_obj.gpu_addr = amdgpu_bo_gpu_offset(wptr_obj->obj);
+	queue->wptr_bo_offset = offset;
+	wptr_obj->gpu_addr = amdgpu_bo_gpu_offset(wptr_obj->obj) + offset;
 
 	drm_exec_fini(&exec);
 	return 0;
diff --git a/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py b/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py
index 822896075d9f..f39ceadb5db6 100644
--- a/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py
+++ b/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py
@@ -117,7 +117,8 @@ struct amdgpu_vm {
 struct amdgpu_device { bool debug_vm; };
 struct xarray { void *values[4]; };
 struct amdgpu_userq_mgr { struct amdgpu_device *adev; struct xarray userq_xa; };
-struct amdgpu_usermode_queue { struct { struct amdgpu_bo *obj; uint64_t gpu_addr; } wptr_obj; };
+struct amdgpu_usermode_queue { struct { struct amdgpu_bo *obj; uint64_t gpu_addr; } wptr_obj;
+                              uint64_t wptr_bo_offset; };
 struct amdgpu_fpriv { struct amdgpu_userq_mgr userq_mgr; struct amdgpu_vm vm; struct amdgpu_bo_va *prt_va; int evf_mgr; };
 struct amdgpu_hmm_range { struct amdgpu_bo *bo; };
 struct ttm_operation_ctx { bool interruptible, no_wait_gpu; };
@@ -149,6 +150,7 @@ static struct amdgpu_bo_va prt;
 static struct amdgpu_device device;
 static bool move_during_validation;
 static unsigned restored, updates, unlocks;
+static uint64_t bo_mc_base;
 static unsigned trace_count, restore_depth, restore_begin, restore_end;
 static int restore_result;
 static bool trace_enabled;
@@ -276,9 +278,17 @@ static int amdgpu_userq_validate_vm(void *data, struct amdgpu_bo *bo) { return 0
 static int amdgpu_vm_update_pdes(struct amdgpu_device *adev, struct amdgpu_vm *vm, bool immediate) { return 0; }
 static int dma_fence_wait(void *fence, bool interruptible) { return 0; }
 static int amdgpu_ttm_alloc_gart(struct ttm_buffer_object *bo) { return 0; }
-static uint64_t amdgpu_bo_gpu_offset(struct amdgpu_bo *bo) { return 0x100000; }
+static uint64_t amdgpu_bo_gpu_offset(struct amdgpu_bo *bo) { return bo_mc_base; }
 static int amdgpu_evf_mgr_rearm(int *manager, struct drm_exec *exec) { return 0; }
-static int amdgpu_userq_restore_all(struct amdgpu_userq_mgr *manager) { restored++; return 0; }
+static int amdgpu_userq_restore_all(struct amdgpu_userq_mgr *manager)
+{
+    struct amdgpu_usermode_queue *queue;
+    unsigned long index;
+    xa_for_each(&manager->userq_xa, index, queue)
+        assert(queue->wptr_obj.gpu_addr == bo_mc_base + queue->wptr_bo_offset);
+    restored++;
+    return 0;
+}
 
 ACTUAL_VALIDATE
 
@@ -307,6 +317,7 @@ static void setup(void)
     list_add(&target_va.base.vm_status, &fpriv.vm.individual.idle);
     move_during_validation = false;
     updates = restored = unlocks = 0;
+    bo_mc_base = 0x100000;
     update_error = validation_error = 0;
     assert(!restore_depth);
     trace_count = restore_begin = restore_end = 0;
@@ -316,6 +327,25 @@ static void setup(void)
 
 int main(void)
 {
+    const uint64_t offsets[] = {0, 8, 4096 - sizeof(uint64_t), 65536 - sizeof(uint64_t)};
+    for (unsigned i = 0; i < sizeof(offsets) / sizeof(offsets[0]); i++) {
+        setup();
+        struct amdgpu_usermode_queue moved = {
+            .wptr_obj = {.obj = &target_bo, .gpu_addr = bo_mc_base + offsets[i]},
+            .wptr_bo_offset = offsets[i],
+        };
+        fpriv.userq_mgr.userq_xa.values[0] = &moved;
+        for (unsigned move = 0; move < 2; move++) {
+            bo_mc_base += 0x100000;
+            target_resource.mem_type = TTM_PL_SYSTEM;
+            assert(amdgpu_userq_vm_validate_and_restore_queue(&fpriv.userq_mgr) == 0);
+            assert(moved.wptr_bo_offset == offsets[i]);
+            assert(moved.wptr_obj.gpu_addr == bo_mc_base + offsets[i]);
+            assert(restored == move + 1 && !target_resv.owner);
+        }
+    }
+    puts("UserQ restore: zero/nonzero WPTR offsets preserved across repeated BO moves");
+
     setup();
     struct amdgpu_usermode_queue queue = {.wptr_obj.obj = &target_bo};
     fpriv.userq_mgr.userq_xa.values[0] = &queue;
diff --git a/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py b/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py
index 3f9ae54d747d..e7b1c11291ac 100644
--- a/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py
+++ b/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py
@@ -59,7 +59,10 @@ class UserqUpstreamTests(unittest.TestCase):
     def test_wptr_buffers(self):
         body = self.function('amdgpu_userq_fence.c', 'amdgpu_userq_fence_read_wptr')
         body += '\n' + self.function('mes_userqueue.c', 'mes_userq_create_wptr_mapping')
-        self.run_program(WPTR_HARNESS.replace('ACTUAL_WPTR', body))
+        source = WPTR_HARNESS.replace('ACTUAL_WPTR', body)
+        for page_size in (4096, 65536):
+            with self.subTest(page_size=page_size):
+                self.run_program(source.replace('TEST_PAGE_SIZE', str(page_size)))
 
 
     def test_firmware_copy_errors(self):
@@ -237,7 +240,8 @@ WPTR_HARNESS = r'''
 #include <stdio.h>
 typedef uint64_t u64;
 #define AMDGPU_GPU_PAGE_SHIFT 12
-#define PAGE_SIZE 4096
+#define PAGE_SIZE TEST_PAGE_SIZE
+#define check_add_overflow(a, b, result) __builtin_add_overflow(a, b, result)
 #define TTM_NUM_MOVE_FENCES 2
 #define AMDGPU_GMC_HOLE_MASK 0x0000ffffffffffffULL
 #define DRM_EXEC_IGNORE_DUPLICATES 1
@@ -248,14 +252,14 @@ typedef uint64_t u64;
 #define drm_exec_retry_on_contention(e) ((void)0)
 struct drm_exec { int unused; };
 struct gem_object { size_t size; bool imported; };
-struct amdgpu_bo { struct { struct gem_object base; } tbo; uint64_t words[1024]; unsigned refs; };
+struct amdgpu_bo { struct { struct gem_object base; } tbo; uint64_t words[PAGE_SIZE / sizeof(u64) + 512]; unsigned refs; };
 struct amdgpu_bo_va { struct { struct amdgpu_bo *bo; } base; };
 struct amdgpu_bo_va_mapping { u64 start, last, offset; struct amdgpu_bo_va *bo_va; };
 struct amdgpu_vm { struct amdgpu_bo_va_mapping *mapping; };
 struct amdgpu_userq_obj { struct amdgpu_bo *obj; u64 gpu_addr; };
 struct userq_props { u64 wptr_gpu_addr; };
 struct amdgpu_usermode_queue { struct amdgpu_vm *vm; struct userq_props *userq_prop;
-                              struct amdgpu_userq_obj wptr_obj; };
+                              struct amdgpu_userq_obj wptr_obj; u64 wptr_bo_offset; };
 struct amdgpu_userq_mgr { int evf_mgr; };
 struct amdgpu_device { int unused; };
 static int pd_error, bo_error, map_error, attach_error, gart_error;
@@ -296,7 +300,7 @@ int main(void)
     struct amdgpu_vm vm = {.mapping = &mapping};
     struct userq_props props = {0};
     struct amdgpu_usermode_queue queue = {.vm = &vm, .userq_prop = &props};
-    for (unsigned i = 0; i < 1024; ++i)
+    for (unsigned i = 0; i < sizeof(bo.words) / sizeof(bo.words[0]); ++i)
         bo.words[i] = 0x1000000000000000ULL + i;
     u64 result = 0;
     unsigned cases = 0;
@@ -333,7 +337,27 @@ int main(void)
     mapping.offset = 0;
     bo.tbo.base.size = PAGE_SIZE;
     struct amdgpu_userq_mgr mgr = {0};
-    assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base) == 0);
+    unsigned mc_cases = 0;
+    /* GPU pages stay 4 KiB, including hosts with 64 KiB CPU pages. */
+    for (u64 mapping_offset = 0; mapping_offset < PAGE_SIZE; mapping_offset += 4096) {
+        mapping.offset = mapping_offset;
+        mapping.last = (base + PAGE_SIZE - mapping_offset - 1) >> AMDGPU_GPU_PAGE_SHIFT;
+        for (u64 offset = 0; offset < PAGE_SIZE - mapping_offset; offset += sizeof(u64)) {
+            props.wptr_gpu_addr = base + offset;
+            assert(amdgpu_userq_fence_read_wptr(&adev, &queue, &result) == 0);
+            assert(result == bo.words[(mapping_offset + offset) / sizeof(u64)]);
+            assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, props.wptr_gpu_addr) == 0);
+            assert(queue.wptr_obj.obj == &bo && bo.refs == 1);
+            assert(queue.wptr_obj.gpu_addr == 0x2000000 + mapping_offset + offset);
+            assert(queue.wptr_bo_offset == mapping_offset + offset);
+            amdgpu_bo_unref(&queue.wptr_obj.obj);
+            mc_cases++;
+        }
+    }
+    mapping.offset = 0;
+    mapping.last = (base + PAGE_SIZE - 1) >> AMDGPU_GPU_PAGE_SHIFT;
+    props.wptr_gpu_addr = base | 0xffff000000000000ULL;
+    assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, props.wptr_gpu_addr) == 0);
     assert(queue.wptr_obj.obj == &bo && bo.refs == 1);
     assert(queue.wptr_obj.gpu_addr == 0x2000000);
     struct amdgpu_bo imported = {.tbo.base = {.size = PAGE_SIZE, .imported = true}};
@@ -350,6 +374,28 @@ int main(void)
     assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base) == -EINVAL);
     assert(bo.refs == 0);
     bo.tbo.base.size = PAGE_SIZE;
+    /* Reject incomplete/overflowed BO spans before attaching or binding. */
+    struct { u64 size, mapping_offset, offset; } invalid[] = {
+        {0, 0, 0}, {sizeof(u64) - 1, 0, 0},
+        {PAGE_SIZE, 0, PAGE_SIZE - sizeof(u64) + 1},
+        {PAGE_SIZE, PAGE_SIZE, 0}, {PAGE_SIZE, PAGE_SIZE - 4, 0},
+        {PAGE_SIZE, UINT64_MAX - 7, 8},
+    };
+    old_attached = attached;
+    old_gart = gart;
+    for (unsigned i = 0; i < sizeof(invalid) / sizeof(invalid[0]); i++) {
+        bo.tbo.base.size = invalid[i].size;
+        mapping.offset = invalid[i].mapping_offset;
+        assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base + invalid[i].offset) == -EINVAL);
+        assert(!bo.refs && !queue.wptr_obj.obj);
+    }
+    bo.tbo.base.size = PAGE_SIZE;
+    mapping.offset = 0;
+    mapping.last = mapping.start;
+    assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base + 4096 - 4) == -EINVAL);
+    assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base + 4096) == -EINVAL);
+    assert(!bo.refs && !queue.wptr_obj.obj && attached == old_attached && gart == old_gart);
+    mapping.last = (base + PAGE_SIZE - 1) >> AMDGPU_GPU_PAGE_SHIFT;
     attach_error = -ENOMEM;
     assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base) == -ENOMEM);
     assert(bo.refs == 0);
@@ -357,7 +403,8 @@ int main(void)
     gart_error = -EIO;
     assert(mes_userq_create_wptr_mapping(&adev, &mgr, &queue, base) == -EIO);
     assert(bo.refs == 0);
-    printf("UserQ WPTR: %u offsets, imported buffers and mapping failures passed\n", cases);
+    printf("UserQ WPTR: %u CPU offsets, %u MC offsets, bounds and failures passed (page size %u)\n",
+           cases, mc_cases, PAGE_SIZE);
     return 0;
 }
 '''
