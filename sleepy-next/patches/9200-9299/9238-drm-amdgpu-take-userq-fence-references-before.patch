+#define lockdep_assert_held(p) assert(*(p))
+#define list_add_tail(entry, list) assert(!"unexpected pending fence")
+#define rcu_read_lock() ((void)0)
+#define rcu_read_unlock() ((void)0)
+#define XA_FREE_MARK 0
+#define XA_PRESENT 0
