From 674c0c61074a4b25fca63152a2bae52c0a14a101 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Wed, 28 Oct 2026 00:58:48 +0100
Subject: [PATCH] drm/amdgpu: Batch sparse VA operations.

(cherry picked from commit 47b10740affdf26f3eb370ab83a0983c217be8a7)
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c |   2 +
 drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c | 154 ++++++++++++++++++++++++
 drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h |   2 +
 drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c |  12 ++
 drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c  |  68 +++++++----
 drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h  |   5 +
 include/uapi/drm/amdgpu_drm.h           |  49 ++++++++
 7 files changed, 269 insertions(+), 23 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index b2eacdf4c6cd..80e8c2a3f1cf 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -3130,6 +3130,8 @@ const struct drm_ioctl_desc amdgpu_ioctls_kms[] = {
 	DRM_IOCTL_DEF_DRV(AMDGPU_WAIT_FENCES, amdgpu_cs_wait_fences_ioctl, DRM_AUTH|DRM_RENDER_ALLOW),
 	DRM_IOCTL_DEF_DRV(AMDGPU_GEM_METADATA, amdgpu_gem_metadata_ioctl, DRM_AUTH|DRM_RENDER_ALLOW),
 	DRM_IOCTL_DEF_DRV(AMDGPU_GEM_VA, amdgpu_gem_va_ioctl, DRM_AUTH|DRM_RENDER_ALLOW),
+	DRM_IOCTL_DEF_DRV(AMDGPU_GEM_VA_BATCH, amdgpu_gem_va_batch_ioctl,
+			  DRM_AUTH | DRM_RENDER_ALLOW),
 	DRM_IOCTL_DEF_DRV(AMDGPU_GEM_OP, amdgpu_gem_op_ioctl, DRM_AUTH|DRM_RENDER_ALLOW),
 	DRM_IOCTL_DEF_DRV(AMDGPU_GEM_USERPTR, amdgpu_gem_userptr_ioctl, DRM_AUTH|DRM_RENDER_ALLOW),
 	DRM_IOCTL_DEF_DRV(AMDGPU_USERQ, amdgpu_userq_ioctl, DRM_AUTH|DRM_RENDER_ALLOW),
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
index 213bebe2623c..bd247adf0ef6 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
@@ -1067,6 +1067,160 @@ int amdgpu_gem_va_ioctl(struct drm_device *dev, void *data,
 	return r;
 }
 
+struct amdgpu_va_batch_entry {
+	struct drm_gem_object *obj;
+	struct amdgpu_bo_va *bo_va;
+	struct amdgpu_bo_va_mapping *maps[3];
+};
+
+int amdgpu_gem_va_batch_ioctl(struct drm_device *dev, void *data,
+			    struct drm_file *filp)
+{
+	const u32 flags = AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE |
+		AMDGPU_VM_PAGE_EXECUTABLE | AMDGPU_VM_MTYPE_MASK | AMDGPU_VM_PAGE_NOALLOC;
+	struct drm_amdgpu_gem_va_batch *args = data;
+	struct amdgpu_device *adev = drm_to_adev(dev);
+	struct amdgpu_fpriv *fpriv = filp->driver_priv;
+	struct amdgpu_vm *vm = &fpriv->vm;
+	struct drm_amdgpu_gem_va_batch_op *ops;
+	struct amdgpu_va_batch_entry *entries;
+	struct amdgpu_bo_va *bo_va;
+	struct drm_exec exec;
+	DEFINE_XARRAY(bos);
+	u64 end, vm_size = adev->vm_manager.max_pfn * AMDGPU_GPU_PAGE_SIZE;
+	unsigned long index;
+	u32 i, j;
+	int r;
+
+	if (args->cookie != AMDGPU_GEM_VA_BATCH_COOKIE || args->flags ||
+	    args->reserved[0] || args->reserved[1] ||
+	    !args->count || args->count > AMDGPU_GEM_VA_BATCH_MAX_OPS)
+		return -EINVAL;
+	if (adev->debug_vm || vm->use_cpu_for_update)
+		return -EOPNOTSUPP;
+	ops = vmemdup_user(u64_to_user_ptr(args->operations),
+			  array_size(args->count, sizeof(*ops)));
+	if (IS_ERR(ops))
+		return PTR_ERR(ops);
+	entries = kvcalloc(args->count, sizeof(*entries), GFP_KERNEL);
+	if (!entries) {
+		kvfree(ops);
+		return -ENOMEM;
+	}
+
+	/* No mapping mutation or GPU submission during preparation. */
+	for (i = 0; i < args->count; ++i) {
+		struct drm_amdgpu_gem_va_batch_op *op = &ops[i];
+		struct amdgpu_bo *bo = NULL;
+
+		r = -EINVAL;
+		if ((op->flags & ~flags) && op->flags != AMDGPU_VM_PAGE_PRT)
+			goto out;
+		if (op->flags & AMDGPU_VM_PAGE_PRT) {
+			if (op->handle || op->offset_in_bo)
+				goto out;
+		} else {
+			entries[i].obj = drm_gem_object_lookup(filp, op->handle);
+			if (!entries[i].obj) {
+				r = -ENOENT;
+				goto out;
+			}
+			bo = gem_to_amdgpu_bo(entries[i].obj);
+		}
+		if (op->va_address < AMDGPU_VA_RESERVED_BOTTOM ||
+		    (op->va_address >= AMDGPU_GMC_HOLE_START &&
+		     op->va_address < AMDGPU_GMC_HOLE_END))
+			goto out;
+		op->va_address &= AMDGPU_GMC_HOLE_MASK;
+		if (check_add_overflow(op->va_address, op->map_size, &end) ||
+		    end > vm_size - AMDGPU_VA_RESERVED_TOP)
+			goto out;
+		r = amdgpu_vm_verify_parameters(adev, bo, op->va_address,
+					       op->offset_in_bo, op->map_size);
+		if (r)
+			goto out;
+		for (j = 0; j < ARRAY_SIZE(entries[i].maps); ++j) {
+			entries[i].maps[j] = kzalloc_obj(*entries[i].maps[j]);
+			if (!entries[i].maps[j]) {
+				r = -ENOMEM;
+				goto out;
+			}
+		}
+	}
+
+	drm_exec_init(&exec, DRM_EXEC_INTERRUPTIBLE_WAIT |
+		      DRM_EXEC_IGNORE_DUPLICATES, 0);
+	drm_exec_until_all_locked(&exec) {
+		for (i = 0; i < args->count; ++i) {
+			if (!entries[i].obj)
+				continue;
+			r = drm_exec_lock_obj(&exec, entries[i].obj);
+			drm_exec_retry_on_contention(&exec);
+			if (r)
+				goto unlock;
+		}
+		r = amdgpu_vm_lock_pd(vm, &exec, 2);
+		drm_exec_retry_on_contention(&exec);
+		if (r)
+			goto unlock;
+	}
+	for (i = 0; i < args->count; ++i) {
+		bo_va = entries[i].obj ?
+			amdgpu_vm_bo_find(vm, gem_to_amdgpu_bo(entries[i].obj)) :
+			fpriv->prt_va;
+		if (!bo_va) {
+			r = -ENOENT;
+			goto unlock;
+		}
+		entries[i].bo_va = bo_va;
+		r = xa_err(xa_store(&bos, ops[i].handle, bo_va, GFP_KERNEL));
+		if (r)
+			goto unlock;
+	}
+
+	/* This phase consumes the prepared records and cannot fail. */
+	for (i = 0; i < args->count; ++i)
+		amdgpu_vm_bo_replace_map_prealloc(adev, entries[i].bo_va,
+			ops[i].va_address, ops[i].offset_in_bo, ops[i].map_size,
+			ops[i].flags, entries[i].maps);
+
+	/* Like GEM_VA, leave updates pending until CS validates the VM. */
+	if (!amdgpu_vm_ready(vm)) {
+		r = 0;
+		goto unlock;
+	}
+
+	/* Reuse existing batching, reservation dependencies and invalidation. */
+	r = amdgpu_vm_clear_freed(adev, vm, &vm->last_update);
+	if (!r) {
+		xa_for_each(&bos, index, bo_va) {
+			r = amdgpu_vm_bo_update(adev, bo_va, false);
+			if (r)
+				break;
+		}
+	}
+	if (!r)
+		r = amdgpu_vm_update_pdes(adev, vm, false);
+	/* Acceptance is final. CS retries unfinished clears, mappings and PDEs. */
+	if (r)
+		dev_dbg_ratelimited(adev->dev,
+				    "Deferred batch page-table update after error %d\n", r);
+	r = 0;
+unlock:
+	drm_exec_fini(&exec);
+out:
+	xa_destroy(&bos);
+	for (i = 0; i < args->count; ++i) {
+		for (j = 0; j < ARRAY_SIZE(entries[i].maps); ++j)
+			kfree(entries[i].maps[j]);
+		if (entries[i].obj)
+			drm_gem_object_put(entries[i].obj);
+	}
+	kvfree(entries);
+	kvfree(ops);
+	return r;
+}
+
 int amdgpu_gem_op_ioctl(struct drm_device *dev, void *data,
 			struct drm_file *filp)
 {
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h
index b558336bc4c6..30751afbb874 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.h
@@ -65,6 +65,8 @@ int amdgpu_gem_wait_idle_ioctl(struct drm_device *dev, void *data,
 			      struct drm_file *filp);
 int amdgpu_gem_va_ioctl(struct drm_device *dev, void *data,
 			  struct drm_file *filp);
+int amdgpu_gem_va_batch_ioctl(struct drm_device *dev, void *data,
+			    struct drm_file *filp);
 int amdgpu_gem_op_ioctl(struct drm_device *dev, void *data,
 			struct drm_file *filp);
 int amdgpu_gem_list_handles_ioctl(struct drm_device *dev, void *data,
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c
index f8a8a48deb75..b7e3886a7b5b 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c
@@ -678,6 +678,18 @@ int amdgpu_info_ioctl(struct drm_device *dev, void *data, struct drm_file *filp)
 		return -EINVAL;
 
 	switch (info->query) {
+	case AMDGPU_INFO_GEM_VA_BATCH: {
+		struct drm_amdgpu_info_gem_va_batch caps = {
+			.cookie = AMDGPU_GEM_VA_BATCH_COOKIE,
+			.max_ops = AMDGPU_GEM_VA_BATCH_MAX_OPS,
+		};
+
+		fpriv = filp->driver_priv;
+		if (adev->debug_vm || fpriv->vm.use_cpu_for_update)
+			return -EOPNOTSUPP;
+		return copy_to_user(out, &caps, min_t(u32, size, sizeof(caps))) ?
+			-EFAULT : 0;
+	}
 	case AMDGPU_INFO_ACCEL_WORKING:
 		ui32 = adev->accel_working;
 		return copy_to_user(out, &ui32, min(size, 4u)) ? -EFAULT : 0;
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
index 679dfed88403..7d150e182757 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
@@ -2038,7 +2038,7 @@ static void amdgpu_vm_bo_insert_map(struct amdgpu_device *adev,
 }
 
 /* Validate operation parameters to prevent potential abuse */
-static int amdgpu_vm_verify_parameters(struct amdgpu_device *adev,
+int amdgpu_vm_verify_parameters(struct amdgpu_device *adev,
 					  struct amdgpu_bo *bo,
 					  uint64_t saddr,
 					  uint64_t offset,
@@ -2245,45 +2245,32 @@ int amdgpu_vm_bo_unmap(struct amdgpu_device *adev,
 }
 
 /**
- * amdgpu_vm_bo_clear_mappings - remove all mappings in a specific range
+ * amdgpu_vm_bo_clear_mappings_prealloc - clear a validated range
  *
  * @adev: amdgpu_device pointer
  * @vm: VM structure to use
  * @saddr: start of the range
  * @size: size of the range
+ * @before: prepared record for the surviving prefix
+ * @after: prepared record for the surviving suffix
  *
  * Remove all mappings in a range, split them as appropriate.
  *
- * Returns:
- * 0 for success, error for failure.
+ * Consumes both records, retaining used splits and freeing unused ones.
  */
-int amdgpu_vm_bo_clear_mappings(struct amdgpu_device *adev,
-				struct amdgpu_vm *vm,
-				uint64_t saddr, uint64_t size)
+static void amdgpu_vm_bo_clear_mappings_prealloc(struct amdgpu_device *adev,
+				struct amdgpu_vm *vm, uint64_t saddr, uint64_t size,
+				struct amdgpu_bo_va_mapping *before,
+				struct amdgpu_bo_va_mapping *after)
 {
-	struct amdgpu_bo_va_mapping *before, *after, *tmp, *next;
+	struct amdgpu_bo_va_mapping *tmp, *next;
 	LIST_HEAD(removed);
 	uint64_t eaddr;
-	int r;
-
-	r = amdgpu_vm_verify_parameters(adev, NULL, saddr, 0, size);
-	if (r)
-		return r;
 
 	saddr /= AMDGPU_GPU_PAGE_SIZE;
 	eaddr = saddr + (size - 1) / AMDGPU_GPU_PAGE_SIZE;
 
-	/* Allocate all the needed memory */
-	before = kzalloc_obj(*before);
-	if (!before)
-		return -ENOMEM;
 	INIT_LIST_HEAD(&before->list);
-
-	after = kzalloc_obj(*after);
-	if (!after) {
-		kfree(before);
-		return -ENOMEM;
-	}
 	INIT_LIST_HEAD(&after->list);
 
 	/* Now gather all removed mappings */
@@ -2360,10 +2347,45 @@ int amdgpu_vm_bo_clear_mappings(struct amdgpu_device *adev,
 	} else {
 		kfree(after);
 	}
+}
 
+int amdgpu_vm_bo_clear_mappings(struct amdgpu_device *adev,
+			       struct amdgpu_vm *vm, uint64_t saddr, uint64_t size)
+{
+	struct amdgpu_bo_va_mapping *before, *after;
+	int r = amdgpu_vm_verify_parameters(adev, NULL, saddr, 0, size);
+
+	if (r)
+		return r;
+	before = kzalloc_obj(*before);
+	if (!before)
+		return -ENOMEM;
+	after = kzalloc_obj(*after);
+	if (!after) {
+		kfree(before);
+		return -ENOMEM;
+	}
+	amdgpu_vm_bo_clear_mappings_prealloc(adev, vm, saddr, size, before, after);
 	return 0;
 }
 
+/* Parameters are validated and all three records allocated before mutation. */
+void amdgpu_vm_bo_replace_map_prealloc(struct amdgpu_device *adev,
+		struct amdgpu_bo_va *bo_va, uint64_t saddr, uint64_t offset,
+		uint64_t size, uint32_t flags, struct amdgpu_bo_va_mapping **maps)
+{
+	struct amdgpu_bo_va_mapping *mapping = maps[0];
+
+	amdgpu_vm_bo_clear_mappings_prealloc(adev, bo_va->base.vm, saddr, size,
+					   maps[1], maps[2]);
+	mapping->start = saddr / AMDGPU_GPU_PAGE_SIZE;
+	mapping->last = mapping->start + (size - 1) / AMDGPU_GPU_PAGE_SIZE;
+	mapping->offset = offset;
+	mapping->flags = flags;
+	amdgpu_vm_bo_insert_map(adev, bo_va, mapping);
+	maps[0] = maps[1] = maps[2] = NULL;
+}
+
 /**
  * amdgpu_vm_bo_lookup_mapping - find mapping by address
  *
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
index 710bc076bd53..2f2cccc555fb 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
@@ -502,6 +502,11 @@ int amdgpu_vm_bo_replace_map(struct amdgpu_device *adev,
 			     struct amdgpu_bo_va *bo_va,
 			     uint64_t addr, uint64_t offset,
 			     uint64_t size, uint32_t flags);
+int amdgpu_vm_verify_parameters(struct amdgpu_device *adev, struct amdgpu_bo *bo,
+			       uint64_t addr, uint64_t offset, uint64_t size);
+void amdgpu_vm_bo_replace_map_prealloc(struct amdgpu_device *adev,
+		struct amdgpu_bo_va *bo_va, uint64_t addr, uint64_t offset,
+		uint64_t size, uint32_t flags, struct amdgpu_bo_va_mapping **maps);
 int amdgpu_vm_bo_unmap(struct amdgpu_device *adev,
 		       struct amdgpu_bo_va *bo_va,
 		       uint64_t addr);
diff --git a/include/uapi/drm/amdgpu_drm.h b/include/uapi/drm/amdgpu_drm.h
index 29009f6aabde..e4fee6badbdd 100644
--- a/include/uapi/drm/amdgpu_drm.h
+++ b/include/uapi/drm/amdgpu_drm.h
@@ -60,6 +60,7 @@ extern "C" {
 #define DRM_AMDGPU_GEM_LIST_HANDLES	0x19
 #define DRM_AMDGPU_PROC_OPTIONS		0x1A
 #define DRM_AMDGPU_UALINK_HANDLE	0x1B
+#define DRM_AMDGPU_GEM_VA_BATCH		0x1C
 
 #define DRM_IOCTL_AMDGPU_GEM_CREATE	DRM_IOWR(DRM_COMMAND_BASE + DRM_AMDGPU_GEM_CREATE, union drm_amdgpu_gem_create)
 #define DRM_IOCTL_AMDGPU_GEM_MMAP	DRM_IOWR(DRM_COMMAND_BASE + DRM_AMDGPU_GEM_MMAP, union drm_amdgpu_gem_mmap)
@@ -83,6 +84,54 @@ extern "C" {
 #define DRM_IOCTL_AMDGPU_GEM_LIST_HANDLES DRM_IOWR(DRM_COMMAND_BASE + DRM_AMDGPU_GEM_LIST_HANDLES, struct drm_amdgpu_gem_list_handles)
 #define DRM_IOCTL_AMDGPU_PROC_OPTIONS	DRM_IOWR(DRM_COMMAND_BASE + DRM_AMDGPU_PROC_OPTIONS, struct drm_amdgpu_proc_options)
 #define DRM_IOCTL_AMDGPU_UALINK_HANDLE DRM_IOWR(DRM_COMMAND_BASE + DRM_AMDGPU_UALINK_HANDLE, union drm_amdgpu_ualink_handle)
+#define DRM_IOCTL_AMDGPU_GEM_VA_BATCH \
+	DRM_IOW(DRM_COMMAND_BASE + DRM_AMDGPU_GEM_VA_BATCH, struct drm_amdgpu_gem_va_batch)
+
+/* Local, versioned ABI: probe INFO first. Never infer support from DRM minor. */
+#define AMDGPU_INFO_GEM_VA_BATCH		0x25
+#define AMDGPU_GEM_VA_BATCH_COOKIE	0x53414c4b56414203ULL
+#define AMDGPU_GEM_VA_BATCH_MAX_OPS	4096
+
+struct drm_amdgpu_info_gem_va_batch {
+	__u64 cookie;
+	__u32 max_ops;
+	__u32 reserved;
+};
+
+/* REPLACE operations, in array order. PRT with handle 0 unbinds a range.
+ * DELAY_UPDATE is not accepted: the batch applies all its pending mappings.
+ */
+struct drm_amdgpu_gem_va_batch_op {
+	__u32 handle;
+	__u32 flags;
+	__u64 va_address;
+	__u64 offset_in_bo;
+	__u64 map_size;
+};
+
+/* Batched GEM_VA acceptance. Probe INFO and match the cookie before use.
+ * Reserved fields and flags must be zero.
+ *
+ * A negative ioctl return leaves every mapping unchanged. A zero return accepts
+ * the entire array, in order. The request is input-only, so no copy-out can fail
+ * after acceptance. There is no partial count, secondary status or safe replay
+ * of a successful request.
+ *
+ * Acceptance does not mean GPU completion. As with GEM_VA, page-table updates
+ * may remain pending when the VM is evicted or an update fails. The kernel keeps
+ * that work for command-submission validation, which must complete preparation
+ * successfully before submitting commands. Existing update-fence dependencies
+ * and TLB-invalidation rules remain in effect. Persistent update failures are
+ * reported by command submission, not by replaying the accepted batch.
+ * No userspace semaphore is signaled by this ioctl.
+ */
+struct drm_amdgpu_gem_va_batch {
+	__u64 cookie;
+	__u64 operations;
+	__u32 count;
+	__u32 flags;
+	__u64 reserved[2];
+};
 
 /**
  * DOC: memory domains
