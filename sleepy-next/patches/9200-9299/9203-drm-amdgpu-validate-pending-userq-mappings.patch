From e1c4dff17a7c3a47805ca2cdf55e73466359030b Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Thu, 29 Oct 2026 23:04:52 +0100
Subject: [PATCH] drm/amdgpu: Validate pending UserQ mappings.

(cherry picked from commit 27f2e9658fc43f75ad39ff25336f24a6c5b3d3b5)
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c       |  8 ++++++--
 .../drivers/amdgpu/test_userq_restore.py        | 17 ++++++++++++++++-
 2 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
index 89da1bbeeec5..45d4a33c8fe8 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_userq.c
@@ -1159,8 +1159,12 @@ amdgpu_userq_bo_validate(struct amdgpu_device *adev, struct drm_exec *exec,
 
 retry:
 	spin_lock(&vm->individual_lock);
-	while (!list_empty(&vm->individual.needs_update)) {
-		bo_va = list_first_entry(&vm->individual.needs_update,
+	while (!list_empty(&vm->individual.evicted) ||
+	       !list_empty(&vm->individual.needs_update)) {
+		struct list_head *pending = !list_empty(&vm->individual.evicted) ?
+			&vm->individual.evicted : &vm->individual.needs_update;
+
+		bo_va = list_first_entry(pending,
 					 struct amdgpu_bo_va,
 					 base.vm_status);
 		bo = bo_va->base.bo;
diff --git a/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py b/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py
index 1cceb93eef3b..a798d924292d 100644
--- a/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py
+++ b/tools/testing/selftests/drivers/amdgpu/test_userq_restore.py
@@ -276,6 +276,16 @@ int main(void)
     assert(amdgpu_userq_vm_validate_and_restore_queue(&fpriv.userq_mgr) == 0);
     assert(restored == 1 && !updates && !target_va.cleared);
 
+    for (unsigned evicted = 0; evicted < 2; evicted++) {
+        setup();
+        list_move(&target_va.base.vm_status, evicted ? &fpriv.vm.individual.evicted :
+                                                    &fpriv.vm.individual.needs_update);
+        target_resource.mem_type = TTM_PL_SYSTEM;
+        assert(amdgpu_userq_vm_validate_and_restore_queue(&fpriv.userq_mgr) == 0);
+        assert(restored == 1 && updates == 1 && target_va.mapped && !target_va.cleared);
+        assert(target_resource.mem_type != TTM_PL_SYSTEM && target_bo.refs == 1);
+    }
+
     for (unsigned state = 0; state < 6; state++) {
         setup();
         list_move(&target_va.base.vm_status, &fpriv.vm.individual.needs_update);
@@ -306,7 +316,12 @@ int main(void)
     assert(amdgpu_userq_vm_validate_and_restore_queue(&fpriv.userq_mgr) == -ENOMEM);
     assert(!restored && !target_resv.owner);
 
-    puts("UserQ restore: 10 reservation, residency and failure cases passed");
+    setup();
+    list_move(&target_va.base.vm_status, &fpriv.vm.individual.needs_update);
+    validation_error = -ENOMEM;
+    assert(amdgpu_userq_vm_validate_and_restore_queue(&fpriv.userq_mgr) == -ENOMEM);
+    assert(!restored && !updates && !target_resv.owner && target_bo.refs == 1);
+    puts("UserQ restore: 13 reservation, residency and failure cases passed");
     return 0;
 }
 '''
