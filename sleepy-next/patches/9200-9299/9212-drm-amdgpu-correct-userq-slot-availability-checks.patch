From 6f062b0e46ef0fc7c79a8d7fbcd2b1ea3637ab61 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Sat, 31 Oct 2026 22:19:24 +0100
Subject: [PATCH] drm/amdgpu: Correct UserQ slot availability checks.

(cherry picked from commit 6918d668e3aea55c54a0c2f434b528e509918a0c)
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c       |   4 +-
 .../drivers/amdgpu/test_userq_upstream.py     | 179 +++++++++++++++++-
 2 files changed, 175 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c
index b6802d824e33..f8a8a48deb75 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_kms.c
@@ -474,7 +474,7 @@ static int amdgpu_hw_ip_info(struct amdgpu_device *adev,
 			    !adev->gfx.compute_ring[i].no_user_submission)
 				++num_rings;
 
-		if (!adev->sdma.disable_uq) {
+		if (!adev->gfx.disable_uq) {
 			for (i = 0; i < AMDGPU_MES_MAX_COMPUTE_PIPES; i++)
 				num_slots += hweight32(adev->mes.compute_hqd_mask[i]);
 		}
@@ -489,7 +489,7 @@ static int amdgpu_hw_ip_info(struct amdgpu_device *adev,
 			    !adev->sdma.instance[i].ring.no_user_submission)
 				++num_rings;
 
-		if (!adev->gfx.disable_uq) {
+		if (!adev->sdma.disable_uq) {
 			for (i = 0; i < AMDGPU_MES_MAX_SDMA_PIPES; i++)
 				num_slots += hweight32(adev->mes.sdma_hqd_mask[i]);
 		}
diff --git a/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py b/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py
index 7dda9865832a..3f9ae54d747d 100644
--- a/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py
+++ b/tools/testing/selftests/drivers/amdgpu/test_userq_upstream.py
@@ -44,6 +44,12 @@ class UserqUpstreamTests(unittest.TestCase):
             subprocess.run(flags + [str(program), '-o', str(binary)], check=True, timeout=30)
             subprocess.run([str(binary)], check=True, timeout=30)
 
+    def test_userq_slot_availability(self):
+        body = self.function('amdgpu_kms.c', 'amdgpu_hw_ip_info')
+        cases = body[body.index('\tcase AMDGPU_HW_IP_GFX:'):body.index('\tcase AMDGPU_HW_IP_UVD:')]
+        self.run_program(SLOT_HARNESS.replace('ACTUAL_IP_CASES', cases))
+
+
     def test_destroy_watchdog(self):
         body = self.function('amdgpu_userq.c', 'amdgpu_userq_stop_hang_detect_work')
         body += '\n' + self.function('amdgpu_userq.c', 'amdgpu_userq_destroy')
@@ -56,6 +62,79 @@ class UserqUpstreamTests(unittest.TestCase):
         self.run_program(WPTR_HARNESS.replace('ACTUAL_WPTR', body))
 
 
+    def test_firmware_copy_errors(self):
+        match = re.search(r'\tcase AMDGPU_INFO_UQ_FW_AREAS: (\{.*?^\t\})',
+                          self.source('amdgpu_kms.c'), re.M | re.S)
+        self.assertIsNotNone(match)
+        self.run_program(FIRMWARE_HARNESS.replace('ACTUAL_CASE', match.group(1)))
+
+
+SLOT_HARNESS = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <string.h>
+#define AMDGPU_MES_MAX_GFX_PIPES 2
+#define AMDGPU_MES_MAX_COMPUTE_PIPES 2
+#define AMDGPU_MES_MAX_SDMA_PIPES 2
+#define hweight32(value) __builtin_popcount(value)
+enum { AMDGPU_HW_IP_GFX, AMDGPU_HW_IP_COMPUTE, AMDGPU_HW_IP_DMA };
+enum { AMD_IP_BLOCK_TYPE_GFX, AMD_IP_BLOCK_TYPE_SDMA };
+struct ring { struct { bool ready; } sched; bool no_user_submission; };
+struct amdgpu_device {
+    struct { bool disable_uq; unsigned int num_gfx_rings, num_compute_rings;
+             struct ring gfx_ring[2], compute_ring[4]; } gfx;
+    struct { bool disable_uq; unsigned int num_instances;
+             struct { struct ring ring; } instance[2]; } sdma;
+    struct { unsigned int gfx_hqd_mask[2], compute_hqd_mask[2], sdma_hqd_mask[2]; } mes;
+};
+static unsigned int query_slots(struct amdgpu_device *adev, unsigned int ip)
+{
+    unsigned int type = 0, num_rings = 0, num_slots = 0, i;
+    unsigned int ib_start_alignment = 0, ib_size_alignment = 0;
+    switch (ip) {
+ACTUAL_IP_CASES
+    default: assert(false);
+    }
+    assert(num_rings == (ip == AMDGPU_HW_IP_COMPUTE ? 4u : 2u));
+    assert(type == (ip == AMDGPU_HW_IP_DMA ? AMD_IP_BLOCK_TYPE_SDMA : AMD_IP_BLOCK_TYPE_GFX));
+    assert(ib_start_alignment == (ip == AMDGPU_HW_IP_DMA ? 256u : 32u));
+    assert(ib_size_alignment == (ip == AMDGPU_HW_IP_DMA ? 4u : 32u));
+    return num_slots;
+}
+int main(void)
+{
+    struct amdgpu_device adev = {0};
+    unsigned int i, flags;
+    adev.gfx.num_gfx_rings = adev.sdma.num_instances = 2;
+    adev.gfx.num_compute_rings = 4;
+    for (i = 0; i < 4; i++) adev.gfx.compute_ring[i].sched.ready = true;
+    for (i = 0; i < 2; i++) {
+        adev.gfx.gfx_ring[i].sched.ready = true;
+        adev.sdma.instance[i].ring.sched.ready = true;
+    }
+    adev.mes.gfx_hqd_mask[0] = 0x86;
+    adev.mes.gfx_hqd_mask[1] = 0x10;
+    adev.mes.compute_hqd_mask[0] = 0xf;
+    adev.mes.compute_hqd_mask[1] = 0x30;
+    adev.mes.sdma_hqd_mask[0] = 0x5;
+    adev.mes.sdma_hqd_mask[1] = 0x40;
+    for (flags = 0; flags < 4; flags++) {
+        adev.gfx.disable_uq = flags & 1;
+        adev.sdma.disable_uq = flags & 2;
+        assert(query_slots(&adev, AMDGPU_HW_IP_GFX) == (adev.gfx.disable_uq ? 0u : 4u));
+        assert(query_slots(&adev, AMDGPU_HW_IP_COMPUTE) == (adev.gfx.disable_uq ? 0u : 6u));
+        assert(query_slots(&adev, AMDGPU_HW_IP_DMA) == (adev.sdma.disable_uq ? 0u : 3u));
+    }
+    memset(&adev.mes, 0, sizeof(adev.mes));
+    adev.gfx.disable_uq = adev.sdma.disable_uq = false;
+    for (i = 0; i < 3; i++) assert(query_slots(&adev, i) == 0);
+    puts("UserQ slot availability tests passed.");
+    return 0;
+}
+'''
+
+
 DESTROY_HARNESS = r'''
 #include <assert.h>
 #include <errno.h>
@@ -70,8 +149,9 @@ static unsigned spin_depth;
 struct amdgpu_usermode_queue;
 struct work { bool pending; struct mutex *needed; struct amdgpu_usermode_queue *queue; };
 struct amdgpu_userq_funcs { void (*mqd_destroy)(struct amdgpu_usermode_queue *); };
+struct reset_domain { int wq; };
 struct amdgpu_device { const struct amdgpu_userq_funcs *userq_funcs[1];
-                       struct { int wq; } *reset_domain; void *dev; };
+                       struct reset_domain *reset_domain; void *dev; };
 struct amdgpu_userq_mgr { struct amdgpu_device *adev; struct work resume_work, reset_work;
                          struct mutex userq_mutex; int userq_count[1]; };
 struct amdgpu_usermode_queue { unsigned queue_type; struct work hang_detect_work;
@@ -126,8 +206,8 @@ int main(void)
     for (unsigned pending = 0; pending < 2; pending++) {
         for (unsigned failed = 0; failed < 2; failed++) {
             struct amdgpu_device adev = {.userq_funcs = {&funcs}};
-            struct { int wq; } domain = {0};
-            adev.reset_domain = (void *)&domain;
+            struct reset_domain domain = {0};
+            adev.reset_domain = &domain;
             struct amdgpu_userq_mgr mgr = {.adev = &adev, .userq_count = {1}};
             struct amdgpu_usermode_queue *queue = calloc(1, sizeof(*queue));
             assert(queue);
@@ -173,7 +253,8 @@ struct amdgpu_bo_va { struct { struct amdgpu_bo *bo; } base; };
 struct amdgpu_bo_va_mapping { u64 start, last, offset; struct amdgpu_bo_va *bo_va; };
 struct amdgpu_vm { struct amdgpu_bo_va_mapping *mapping; };
 struct amdgpu_userq_obj { struct amdgpu_bo *obj; u64 gpu_addr; };
-struct amdgpu_usermode_queue { struct amdgpu_vm *vm; struct { u64 wptr_gpu_addr; } *userq_prop;
+struct userq_props { u64 wptr_gpu_addr; };
+struct amdgpu_usermode_queue { struct amdgpu_vm *vm; struct userq_props *userq_prop;
                               struct amdgpu_userq_obj wptr_obj; };
 struct amdgpu_userq_mgr { int evf_mgr; };
 struct amdgpu_device { int unused; };
@@ -213,8 +294,8 @@ int main(void)
     const u64 base = 0x123450000ULL;
     struct amdgpu_bo_va_mapping mapping = {.start = base >> 12, .last = base >> 12, .bo_va = &bo_va};
     struct amdgpu_vm vm = {.mapping = &mapping};
-    struct { u64 wptr_gpu_addr; } props = {0};
-    struct amdgpu_usermode_queue queue = {.vm = &vm, .userq_prop = (void *)&props};
+    struct userq_props props = {0};
+    struct amdgpu_usermode_queue queue = {.vm = &vm, .userq_prop = &props};
     for (unsigned i = 0; i < 1024; ++i)
         bo.words[i] = 0x1000000000000000ULL + i;
     u64 result = 0;
@@ -282,5 +363,91 @@ int main(void)
 '''
 
 
+FIRMWARE_HARNESS = r'''
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include "amdgpu_drm.h"
+#define min(a,b) ((a) < (b) ? (a) : (b))
+struct amdgpu_device { int unused; };
+static int metadata_error;
+static size_t copy_error, copied;
+static unsigned copies, queries;
+static int metadata(void *out, size_t size)
+{ queries++; memset(out, 0xa5, size); return metadata_error; }
+#define GETTER(name, type) \
+static int name(struct amdgpu_device *adev, struct drm_amdgpu_info *info, struct type *out) \
+{ (void)adev; (void)info; return metadata(out, sizeof(*out)); }
+GETTER(amdgpu_userq_metadata_info_gfx, drm_amdgpu_info_uq_metadata_gfx)
+GETTER(amdgpu_userq_metadata_info_compute, drm_amdgpu_info_uq_metadata_compute)
+GETTER(amdgpu_userq_metadata_info_sdma, drm_amdgpu_info_uq_metadata_sdma)
+static size_t copy_to_user(void *out, const void *data, size_t size)
+{
+    copies++;
+    copied = size;
+    if (!size)
+        return 0;
+    if (!out)
+        return size;
+    if (copy_error)
+        return copy_error;
+    memcpy(out, data, size);
+    return 0;
+}
+static int query(struct amdgpu_device *adev, struct drm_amdgpu_info *info, void *out, unsigned size)
+{
+    int ret;
+    switch (info->query) {
+    case AMDGPU_INFO_UQ_FW_AREAS:
+        ACTUAL_CASE
+    default:
+        return -EINVAL;
+    }
+}
+int main(void)
+{
+    struct amdgpu_device adev = {0};
+    struct drm_amdgpu_info info = {.query = AMDGPU_INFO_UQ_FW_AREAS};
+    const unsigned types[] = {AMDGPU_HW_IP_GFX, AMDGPU_HW_IP_COMPUTE, AMDGPU_HW_IP_DMA};
+    const unsigned metadata_size = sizeof(struct drm_amdgpu_info_uq_metadata);
+    const unsigned sizes[] = {0, 1, 8, metadata_size, metadata_size + 4};
+    unsigned char output[sizeof(struct drm_amdgpu_info_uq_metadata) + 4];
+    for (unsigned i = 0; i < 3; i++) {
+        info.query_hw_ip.type = types[i];
+        for (unsigned j = 0; j < 5; j++) {
+            memset(output, 0xcc, sizeof(output));
+            assert(query(&adev, &info, output, sizes[j]) == 0);
+            assert(copied == min(sizes[j], metadata_size));
+            if (copied)
+                assert(output[0] == 0xa5);
+            assert(output[copied] == 0xcc);
+        }
+        assert(query(&adev, &info, NULL, metadata_size) == -EFAULT);
+        assert(query(&adev, &info, NULL, 0) == 0);
+        copy_error = 1;
+        assert(query(&adev, &info, output, metadata_size) == -EFAULT);
+        copy_error = 0;
+        metadata_error = -EOPNOTSUPP;
+        unsigned old_copies = copies;
+        assert(query(&adev, &info, output, metadata_size) == -EOPNOTSUPP);
+        assert(copies == old_copies);
+        metadata_error = 0;
+    }
+    info.query_hw_ip.type = 99;
+    unsigned old_queries = queries;
+    assert(query(&adev, &info, output, metadata_size) == -EINVAL);
+    info.query = 0xffffffff;
+    assert(query(&adev, &info, output, metadata_size) == -EINVAL);
+    assert(queries == old_queries);
+    puts("UserQ firmware query: GFX, compute and SDMA copy and error cases passed");
+    return 0;
+}
+'''
+
+
 if __name__ == '__main__':
     unittest.main()
