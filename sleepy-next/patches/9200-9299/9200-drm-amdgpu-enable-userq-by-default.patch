From 4ba5b0dde6bb61968cceb349d07b44cc637b364e Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Thu, 29 Oct 2026 20:02:20 +0100
Subject: [PATCH] drm/amdgpu: Enable UserQ by default.

(cherry picked from commit 62a6b0edc972d443e0cc0cc3a8466e258d440247)
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
index 731fe8f9e922..b2eacdf4c6cd 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_drv.c
@@ -251,7 +251,7 @@ int amdgpu_wbrf = -1;
 int amdgpu_damage_clips = -1; /* auto */
 int amdgpu_umsch_mm_fwlog;
 int amdgpu_rebar = -1; /* auto */
-int amdgpu_user_queue = -1;
+int amdgpu_user_queue = 1;
 uint amdgpu_hdmi_hpd_debounce_delay_ms;
 int amdgpu_ptl = -1; /* auto */
 
@@ -1149,10 +1149,10 @@ module_param_named(rebar, amdgpu_rebar, int, 0444);
  *
  * - -1 = auto (ASIC specific default)
  * -  0 = user queues disabled
- * -  1 = user queues enabled and kernel queues enabled (if supported)
+ * -  1 = user queues enabled and kernel queues enabled (if supported, default)
  * -  2 = user queues enabled and kernel queues disabled
  */
-MODULE_PARM_DESC(user_queue, "Enable user queues (-1 = auto (default), 0 = disable, 1 = enable, 2 = enable UQs and disable KQs)");
+MODULE_PARM_DESC(user_queue, "Enable user queues (-1 = auto, 0 = disable, 1 = enable (default), 2 = enable UQs and disable KQs)");
 module_param_named(user_queue, amdgpu_user_queue, int, 0444);
 
 /*
