From 9ffd38b0f610ea4eb107dc8a77b34578e6e78acd Mon Sep 17 00:00:00 2001
From: Kefeng Wang <wangkefeng.wang@huawei.com>
Date: Thu, 10 Sep 2026 20:35:44 +0800
Subject: [PATCH] mm: zswap: reuse zswap_invalidate() in zswap_store()

Reuse zswap_invalidate() in zswap_store() check_old path.  Its
zswap_never_enabled() and xa_empty() guards avoid redundant xarray lookups
and deduplicate the per-slot free logic.

Link: https://lore.kernel.org/20260910123544.818146-4-wangkefeng.wang@huawei.com
Signed-off-by: Kefeng Wang <wangkefeng.wang@huawei.com>
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
Acked-by: Yosry Ahmed <yosry@kernel.org>
Reviewed-by: Johannes Weiner <hannes@cmpxchg.org>
Cc: Chengming Zhou <chengming.zhou@linux.dev>
Cc: Kairui Song <kasong@tencent.com>
Cc: Nhat Pham <nphamcs@gmail.com>
Cc: Yosry Ahmed <yosryahmed@google.com>
---
 mm/zswap.c | 15 ++-------------
 1 file changed, 2 insertions(+), 13 deletions(-)

diff --git a/mm/zswap.c b/mm/zswap.c
--- a/mm/zswap.c
+++ b/mm/zswap.c
@@ -1607,17 +1607,12 @@
 	if (!ret) {
 		unsigned type = swp_type(swp);
 		pgoff_t offset = swp_offset(swp);
-		struct zswap_entry *entry;
-		struct xarray *tree;
 
-		for (index = 0; index < nr_pages; ++index) {
-			tree = swap_zswap_tree(swp_entry(type, offset + index));
-			entry = xa_erase(tree, offset + index);
-			if (entry && !xa_is_value(entry))
-				zswap_entry_free(entry);
-		}
+		zswap_invalidate(type, offset, nr_pages);
 #ifdef CONFIG_LRU_MARIE
 		if (incomp) {
+			struct xarray *tree;
+
 			tree = swap_zswap_tree(swp_entry(type, offset + incomp_index));
 			if (!xa_is_err(xa_store(tree, offset + incomp_index,
 						ZSWAP_INCOMP_MARK,
