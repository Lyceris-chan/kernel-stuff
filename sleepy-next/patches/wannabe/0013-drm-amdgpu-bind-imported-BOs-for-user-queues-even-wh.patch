From 9d45255b110d4c2713dc1053964306aefc0d4623 Mon Sep 17 00:00:00 2001
From: Sleepy <sleepy@example.com>
Date: Wed, 26 Aug 2026 12:29:13 +0200
Subject: [PATCH 13/16] drm/amdgpu: bind imported BOs for user queues even when
 eviction fence signaled

Merge of the v5 fix (amd-gfx ML 151460, 08-25) into
amdgpu_evf_mgr_attach_fence(), combined with the userq-reset 1/5
dma_resv reservation: imports are created in TTM_PL_SYSTEM and this is the
only place a VM using user queues binds them, so validate them even when
the eviction fence is already signaled. The dma_resv slot is only reserved
when the fence is actually added.

ML WIP (v5, 08-25) - isolated in this commit, easy to drop when it lands
upstream.

Co-Authored-By: Claude <noreply@anthropic.com>
---
 .../gpu/drm/amd/amdgpu/amdgpu_eviction_fence.c | 18 ++++++++++++------
 1 file changed, 12 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_eviction_fence.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_eviction_fence.c
index 823d62923932..5fa83c77a920 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_eviction_fence.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_eviction_fence.c
@@ -101,15 +101,21 @@ int amdgpu_evf_mgr_attach_fence(struct amdgpu_eviction_fence_mgr *evf_mgr,
 	struct dma_resv *resv = bo->tbo.base.resv;
 	int ret;
 
-	if (!dma_fence_is_signaled(ev_fence)) {
-
+	/*
+	 * Imports are created in TTM_PL_SYSTEM and this is the only place a VM
+	 * using user queues binds them, so validate those even when the fence
+	 * is already signaled.
+	 */
+	if (!dma_fence_is_signaled(ev_fence) ||
+	    drm_gem_is_imported(&bo->tbo.base)) {
 		amdgpu_bo_placement_from_domain(bo, bo->allowed_domains);
 		ret = ttm_bo_validate(&bo->tbo, &bo->placement, &ctx);
-		if (!ret)
+		if (!ret && !dma_fence_is_signaled(ev_fence)) {
 			ret = dma_resv_reserve_fences(resv, 1);
-		if (!ret)
-			dma_resv_add_fence(resv, ev_fence,
-					   DMA_RESV_USAGE_BOOKKEEP);
+			if (!ret)
+				dma_resv_add_fence(resv, ev_fence,
+						   DMA_RESV_USAGE_BOOKKEEP);
+		}
 	} else {
 		ret = 0;
 	}
