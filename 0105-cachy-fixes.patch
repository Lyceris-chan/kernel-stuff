 #define DATA_BLOCK_2_CONTAINER_ID		0x29
 #define DATA_BLOCK_2_TYPE_10_FORMULA_TIMING	0x2a
+#define DATA_BLOCK_2_ADAPTIVE_SYNC		0x2b
 #define DATA_BLOCK_2_VENDOR_SPECIFIC		0x7e
