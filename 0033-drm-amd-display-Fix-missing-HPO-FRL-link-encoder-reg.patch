From a4d4d2c0a22084e065d322122b4b3233bc2d5f7e Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@gemini.local>
Date: Wed, 1 Jul 2026 13:00:00 +0200
Subject: [PATCH 34/36] drm/amd/display: Fix missing HPO FRL link encoder
 register init

dcn401_hpo_frl_link_encoder_create() emits the register-address list
for HPO FRL link encoder 0 only. Encoder 1's register bases are never
initialized, so driving an FRL link on ENGINE_ID_HPO_1 programs zero
register addresses, which can leave that display blank.

Emit the register list for encoder 1 as well.

Signed-off-by: Antigravity <antigravity@gemini.local>
---
 .../gpu/drm/amd/display/dc/resource/dcn401/dcn401_resource.c   | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/dc/resource/dcn401/dcn401_resource.c b/drivers/gpu/drm/amd/display/dc/resource/dcn401/dcn401_resource.c
index e1a02ef9a..f8a667452 100644
--- a/drivers/gpu/drm/amd/display/dc/resource/dcn401/dcn401_resource.c
+++ b/drivers/gpu/drm/amd/display/dc/resource/dcn401/dcn401_resource.c
@@ -1337,7 +1337,8 @@ static struct hpo_frl_link_encoder *dcn401_hpo_frl_link_encoder_create(
 
 #undef REG_STRUCT
 #define REG_STRUCT hpo_frl_link_enc_regs
-	hpo_frl_link_encoder_reg_list(0);
+	hpo_frl_link_encoder_reg_list(0),
+	hpo_frl_link_encoder_reg_list(1);
 
 	/* allocate HPO link encoder */
 	hpo_link_enc = kzalloc(sizeof(struct dcn30_hpo_frl_link_encoder), GFP_KERNEL);
-- 
