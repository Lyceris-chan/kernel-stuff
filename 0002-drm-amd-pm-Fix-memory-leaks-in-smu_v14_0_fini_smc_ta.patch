From f80ef62e0eec0fc0c294da72ee97b36fdbb57f95 Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@gemini.local>
Date: Wed, 1 Jul 2026 13:00:00 +0200
Subject: [PATCH 26/36] drm/amd/pm: Fix memory leaks in
 smu_v14_0_fini_smc_tables

smu_v14_0_fini_smc_tables() frees every driver-table pointer except
user_overdrive_table, which is kzalloc'ed when the SMU tables are
initialized and populated with the user's overdrive settings. On table
finalization that buffer is never released, leaking memory on module
unload, suspend, and reset.

kfree() user_overdrive_table and set it to NULL alongside the other
table pointers so the teardown is complete and idempotent.

Signed-off-by: Antigravity <antigravity@gemini.local>
---
 drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0.c b/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0.c
index 0c8d515ff..1bdce59fe 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0.c
@@ -437,11 +437,13 @@ int smu_v14_0_fini_smc_tables(struct smu_context *smu)
 
 	smu_driver_table_fini(smu, SMU_DRIVER_TABLE_GPU_METRICS);
 	kfree(smu_table->combo_pptable);
+	kfree(smu_table->user_overdrive_table);
 	kfree(smu_table->boot_overdrive_table);
 	kfree(smu_table->overdrive_table);
 	kfree(smu_table->max_sustainable_clocks);
 	kfree(smu_table->driver_pptable);
 	smu_table->combo_pptable = NULL;
+	smu_table->user_overdrive_table = NULL;
 	smu_table->boot_overdrive_table = NULL;
 	smu_table->overdrive_table = NULL;
 	smu_table->max_sustainable_clocks = NULL;
