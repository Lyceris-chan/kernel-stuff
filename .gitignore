# Package build outputs
*.pkg.tar.zst
*.pkg.tar.xz
*.tar.gz
*.tar.xz
*.zip
*.log

# Root-level patch symlinks auto-created by PKGBUILD for makepkg 7.1.0
# basename resolution. Real patches live in patches/<range>/ subfolders.
/*.patch

# Build directories
src/
pkg/
r8125/
repos/
linux-*/
usr/

# Scratch & log files
log*.txt
log.txt
grep_output*.txt
*.bak

# Machine-specific generated configs (keep base 'config' tracked).
# The 7.x patterns cover the mainline package; the preview is date-versioned
# (config-2026.10.09-1-sleepy-next) and escapes them, so match a date prefix too.
config-7.2.*
config-7.3.*
config-[0-9][0-9]*.*
# Local tool state
.kiro/

# Python bytecode and checkpatch scratch
__pycache__/
.checkpatch-*

# Scratch from verification runs (patchwork fetches, diffs)
.verify-tmp/

# Patch-application leftovers. GNU patch defaults to --backup-if-mismatch, so a
# hunk that applies with an offset leaves a .orig beside the file, and a failed
# hunk leaves a .rej. Both have been swept into regenerated patches before.
*.rej
*.orig
*.part

# Claude Code session state. Some of this is also in .git/info/exclude, which is
# repo-local and does not travel with a clone; these belong in the shared file.
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/settings.local.json
