From 882e8148ae7ec0c504c472b01cdebe7b69e04da5 Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@gemini.local>
Date: Wed, 1 Jul 2026 13:00:00 +0200
Subject: [PATCH 29/36] drm/amd/pm: Add bounds checking for SMU14 I2C commands

Adds bounds checks to I2C register access on SMU14.
Prevents out-of-bounds memory accesses and system panics.

Signed-off-by: Antigravity <antigravity@gemini.local>
---
 drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_2_ppt.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_2_ppt.c b/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_2_ppt.c
index c61bc0d79..e0ce16fb7 100644
--- a/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_2_ppt.c
+++ b/drivers/gpu/drm/amd/pm/swsmu/smu14/smu_v14_0_2_ppt.c
@@ -1927,7 +1927,13 @@ static int smu_v14_0_2_i2c_xfer(struct i2c_adapter *i2c_adap,
 
 	for (c = i = 0; i < num_msgs; i++) {
 		for (j = 0; j < msg[i].len; j++, c++) {
-			SwI2cCmd_t *cmd = &req->SwI2cCmds[c];
+			SwI2cCmd_t *cmd;
+
+			if (c >= MAX_SW_I2C_COMMANDS) {
+				r = -EINVAL;
+				goto fail;
+			}
+			cmd = &req->SwI2cCmds[c];
 
 			if (!(msg[i].flags & I2C_M_RD)) {
 				/* write */
-- 
2.55.0

