From nobody Mon Sep 17 00:00:00 2001
From: Fangzhi Zuo <Jerry.Zuo@amd.com>
Date: Wed, 30 Jul 2026 20:17:55 -0400
Subject: [PATCH] drm/edid: add the HDMI VRR capability struct without enabling the parse

Add struct drm_hdmi_vrr_cap and the ALLM/FAPA fields to struct drm_hdmi_info so
display drivers can consume them, without parsing them from the HF-VSDB.

[sleepy] Stripped version of the upstream submission
<20260730171754.704049-2-jerry.zuo@amd.com>, which this series carried in full
as patch 0055 until 2026-09-14. The full patch added
drm_parse_hdmi_gaming_info(), which sets vrr_cap.supported=true from the
HF-VSDB VRR range in the sink EDID, and the amdgpu-side fallback (0060) then
turns that into a freesync_capable=true advertisement. On this machine that
advertisement is the trigger for the 240 Hz flicker and the box: the
flicker-free stock kernel shows vrr_capable=0 at runtime on every connector,
while this kernel showed vrr_capable=1.

Dropping the parse and the fallback zeroes the chain to the observed good
state. Only the struct definitions are kept, because the passive-VRR and
freesync patches consume them; 1163's guard is then inert, which matches
upstream behaviour. Note: CachyOS's own tree DOES carry this parser -- the
runtime difference is in the amdgpu-side fallback, so the empirical test of
this build is the runtime vrr_capable value, not the source-level parse.

Signed-off-by: Fangzhi Zuo <Jerry.Zuo@amd.com>
---
diff --git a/include/drm/drm_connector.h b/include/drm/drm_connector.h
index 745cd917fe40..61ea6e866ea0 100644
--- a/include/drm/drm_connector.h
+++ b/include/drm/drm_connector.h
@@ -254,6 +254,44 @@ struct drm_scdc {
 	struct drm_scrambling scrambling;
 };
 
+/**
+ * struct drm_hdmi_vrr_cap - Information about VRR capabilities of a HDMI sink
+ *
+ * Describes the VRR support provided by HDMI 2.1 sink. The information is
+ * fetched fom additional HFVSDB blocks defined for HDMI 2.1.
+ */
+struct drm_hdmi_vrr_cap {
+	/** @fva: flag for Fast VActive (Quick Frame Transport) support */
+	bool fva;
+
+	/** @mcnmvrr: flag for Negative M VRR support */
+	bool cnmvrr;
+
+	/** @mcinema_vrr: flag for Cinema VRR support */
+	bool cinema_vrr;
+
+	/** @mdelta: flag for limited frame-to-frame compensation support */
+	bool mdelta;
+
+	/**
+	 * @vrr_min : minimum supported variable refresh rate in Hz.
+	 * Valid values only inide 1 - 48 range
+	 */
+	u16 vrr_min;
+
+	/**
+	 * @vrr_max : maximum supported variable refresh rate in Hz (optional).
+	 * Valid values are either 0 (max based on video mode) or >= 100
+	 */
+	u16 vrr_max;
+
+	/**
+	 * @supported: flag for vrr support based on checking for VRRmin and
+	 * VRRmax values having correct values.
+	 */
+	bool supported;
+};
+
 /**
  * struct drm_hdmi_dsc_cap - DSC capabilities of HDMI sink
  *
@@ -330,6 +368,15 @@ struct drm_hdmi_info {
 	/** @max_lanes: supported by sink */
 	u8 max_lanes;
 
+	/** @fapa_start_location: flag for the FAPA in blanking support */
+	bool fapa_start_location;
+
+	/** @allm: flag for Auto Low Latency Mode support by sink */
+	bool allm;
+
+	/** @vrr_cap: VRR capabilities of the sink */
+	struct drm_hdmi_vrr_cap vrr_cap;
+
 	/** @dsc_cap: DSC capabilities of the sink */
 	struct drm_hdmi_dsc_cap dsc_cap;
 };
-- 
