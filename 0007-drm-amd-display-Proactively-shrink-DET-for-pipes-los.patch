From dd35d8c822026000fa905b9bde7078c3684f5d20 Mon Sep 17 00:00:00 2001
From: Antigravity <antigravity@gemini.local>
Date: Wed, 1 Jul 2026 13:00:00 +0200
Subject: [PATCH 31/36] drm/amd/display: Proactively shrink DET for pipes
 losing space

Ensures DET size is shrunk prior to applying new scaling parameters.
Prevents pipe underflows and visual artifacts.

Signed-off-by: Antigravity <antigravity@gemini.local>
---
 .../drm/amd/display/dc/hwss/dcn401/dcn401_hwseq.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/dc/hwss/dcn401/dcn401_hwseq.c b/drivers/gpu/drm/amd/display/dc/hwss/dcn401/dcn401_hwseq.c
index 49efd1f11..df9a5fb89 100644
--- a/drivers/gpu/drm/amd/display/dc/hwss/dcn401/dcn401_hwseq.c
+++ b/drivers/gpu/drm/amd/display/dc/hwss/dcn401/dcn401_hwseq.c
@@ -1477,9 +1477,24 @@ void dcn401_prepare_bandwidth(struct dc *dc,
 
 	/* decrease compbuf size */
 	if (hubbub->funcs->program_compbuf_segments) {
+		int i;
 		compbuf_size = context->bw_ctx.bw.dcn.arb_regs.compbuf_size;
 		dc->optimized_required |= (compbuf_size != dc->current_state->bw_ctx.bw.dcn.arb_regs.compbuf_size);
 
+		/* Proactively shrink DET for pipes losing space to prevent transient CRB overflow */
+		for (i = 0; i < dc->res_pool->pipe_count; i++) {
+			struct pipe_ctx *pipe = &context->res_ctx.pipe_ctx[i];
+			struct pipe_ctx *old_pipe = &dc->current_state->res_ctx.pipe_ctx[i];
+
+			if (pipe->stream && pipe->update_flags.bits.det_size &&
+			    pipe->det_buffer_size_kb < old_pipe->det_buffer_size_kb) {
+				if (hubbub->funcs->program_det_size)
+					hubbub->funcs->program_det_size(hubbub, pipe->plane_res.hubp->inst, pipe->det_buffer_size_kb);
+				if (hubbub->funcs->program_det_segments)
+					hubbub->funcs->program_det_segments(hubbub, pipe->plane_res.hubp->inst, pipe->hubp_regs.det_size);
+			}
+		}
+
 		hubbub->funcs->program_compbuf_segments(hubbub, compbuf_size, false);
 	}
 
