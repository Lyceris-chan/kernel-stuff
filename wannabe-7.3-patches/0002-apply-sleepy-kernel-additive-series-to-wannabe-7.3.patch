 /*
  * Serializes oom killer invocations (out_of_memory()) from all contexts to
@@ -720,6 +737,15 @@ static const struct ctl_table vm_oom_kill_table[] = {
 		.mode		= 0644,
 		.proc_handler	= proc_dointvec,
 	},
+	{
