+ * concede_pressure_mode — which pressure signal engages the FILE_THEN_ANON
+ * concede-to-anon (runtime A/B). Bitmask: 1=FREE (free<=2*high), 2=REFAULT
+ * (file-refault feedback), 3=both (default), 0=floor-only (pre-fix baseline,
+ * reproduces the premature OOM). See marie_file_refaulting() in state_reclaim.c.
+ */
+static ssize_t concede_pressure_mode_show(struct kobject *kobj,
+					  struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(marie_concede_pressure_mode));
+}
