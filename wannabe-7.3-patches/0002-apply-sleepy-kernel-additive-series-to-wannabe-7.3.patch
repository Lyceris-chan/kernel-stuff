diff --git a/mm/Kconfig b/mm/Kconfig
index 604c58199acb..cf93b383e59a 100644
--- a/mm/Kconfig
+++ b/mm/Kconfig
@@ -1430,6 +1430,77 @@ config LRU_GEN_WALKS_MMU
