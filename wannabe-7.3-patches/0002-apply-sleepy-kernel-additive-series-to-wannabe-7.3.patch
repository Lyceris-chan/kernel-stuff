+static ssize_t concede_pressure_mode_store(struct kobject *kobj,
+					   struct kobj_attribute *attr,
+					   const char *buf, size_t count)
+{
+	unsigned int v;
+	int err = kstrtouint(buf, 10, &v);
+
+	if (err)
+		return err;
+	if (v > (MARIE_CONCEDE_FREE | MARIE_CONCEDE_REFAULT))
